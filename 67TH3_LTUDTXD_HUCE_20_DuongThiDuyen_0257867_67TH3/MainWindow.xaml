<Window x:Class="_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Trang Chủ" Height="550" Width="800"
WindowStyle ="None"
ResizeMode="NoResize"
WindowStartupLocation="CenterScreen">
    <Border CornerRadius="12">
        <Border.Background>
            <ImageBrush ImageSource ="/Resources/Images/logo.png"
                     Stretch="None"/>
        </Border.Background>

        <Border CornerRadius="10"       
            BorderThickness="1"
            Opacity ="0.95">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#462AD8" Offset="0"/>
                    <GradientStop Color="#DA34AE" Offset="0.75"/>
                    <GradientStop Color="#8A16C1" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#060531" Offset="0"/>
                    <GradientStop Color="#1B1448" Offset="0.75"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="5"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="TRANG CHỦ"
                   Foreground="DarkGray"
                   FontSize="10"
                   FontFamily="Montserrat"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>

                    <Button x:Name="btnMinimize"                            
                BorderThickness="0"
                Content="-"
                Foreground="White"
                FontSize="16"
                FontFamily="Montserrat"
                Cursor="Hand"
                Grid.Column="1"
                Click="btnMinimize_Click">
                        <Button.Style>
                            <Style  TargetType="Button">
                                <Setter Property="Background" Value="#28AEED"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#278BEF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="18" Height="18"
                            CornerRadius="9"
                            Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="btnClose"                      
                 BorderThickness="0"
                 Content="X"
                 Foreground="White"
                 FontSize="12"                           
                 FontFamily="Montserrat"
                 Cursor="Hand"
                 Grid.Column="2"
                 Click="btnClose_Click">

                        <Button.Style>
                            <Style  TargetType="Button">
                                <Setter Property="Background" Value="#DA34AE"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C62DAE"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="18" Height="18"
                            CornerRadius="9"
                            Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>
                <StackPanel Width="800"
                Grid.Row="2"
                Orientation="Vertical"
                Margin="0,0,0,0">
                    <materialDesign:Card>
                        <TabControl
    MinHeight="520"
    materialDesign:ColorZoneAssist.Mode="PrimaryMid"
    materialDesign:NavigationRailAssist.SelectionCornerRadius="50 10 10 10"
    materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
    Style="{StaticResource MaterialDesignNavigationRailTabControl}"
    TabStripPlacement="Top"
   >
                            <materialDesign:NavigationRailAssist.FloatingContent>
                                <Button
        Margin="8"
        Style="{StaticResource MaterialDesignFloatingActionSecondaryButton}">
                                    <materialDesign:PackIcon
          Width="24"
          Height="24"
          Kind="Plus" />
                                </Button>
                            </materialDesign:NavigationRailAssist.FloatingContent>
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel
          Width="auto"
          Height="auto">
                                        <materialDesign:PackIcon
            Width="24"
            Height="24"
            HorizontalAlignment="Center"
            Kind="Folder" />
                                        <TextBlock
            HorizontalAlignment="Center"
            Text="Xem dự án" />
                                    </StackPanel>
                                </TabItem.Header>
                                <StackPanel
        Margin="16">
                                    <ComboBox
  materialDesign:ComboBoxAssist.MaxLength="2"
  materialDesign:HintAssist.Hint="Tên dự án"
  materialDesign:HintAssist.HintOpacity=".26"
  IsEditable="True" Height="25" Width="300" Margin="30,20,600,0"
 >
                                        <ComboBoxItem
    Content="Dự án 1" />
                                        <ComboBoxItem
    Content="Dự án 2" />
                                        <ComboBoxItem
    Content="Dự án 3" />
                                        <ComboBoxItem
    Content="Dự án 4" />
                                    </ComboBox>
                                    <ComboBox
 materialDesign:ComboBoxAssist.MaxLength="2"
 materialDesign:HintAssist.Hint="Chọn tầng"
 materialDesign:HintAssist.HintOpacity=".26"
 IsEditable="True" Height="25" Width="200" Margin="30,150,600,0"
>
                                        <ComboBoxItem
   Content="Tầng 1" />
                                        <ComboBoxItem
   Content="Tầng 2" />
                                        <ComboBoxItem
   Content="Tầng 3" />
                                        <ComboBoxItem
   Content="Tầng 4" />
                                    </ComboBox>
                                    <Button
  Width="180" Height="30"
  Content="TÍNH TOÁN"
  IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
  Style="{StaticResource MaterialDesignFlatMidBgButton}"
  ToolTip="MaterialDesignFlatMidButton" 
                               Margin="0,130,550,0"
  />
                                    <TextBlock Text="BẢNG TÍNH THÉP DỌC" 
                                       Margin="300,-350,0,0" 
                                       FontWeight="UltraBold" 
                                       FontSize="20"/>
                                    <Grid Width="450" Margin="280,-300,0,0" >
                                        <Grid.RowDefinitions>
                                            <!-- 8 Rows -->
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <!-- 4 Columns -->
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Headers -->
                                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="STT Dầm" FontWeight="Bold" Margin="5" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Diện tích mm2" FontWeight="Bold" Margin="5" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Khoảng cách mm" FontWeight="Bold" Margin="5" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Hàm lượng thép%" FontWeight="Bold" Margin="5" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Data Rows -->
                                        <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 1 - A" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 1 - B" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 1 - C" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 1 - D" Margin="5"/>
                                        </Border>

                                        <!-- Lặp lại cho các hàng tiếp theo -->
                                        <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 2 - A" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 2 - B" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 2 - C" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 2 - D" Margin="5"/>
                                        </Border>

                                        <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 3 - A" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 3 - B" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="3" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 3 - C" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="3" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 3 - D" Margin="5"/>
                                        </Border>

                                        <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - A" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - B" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="4" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - C" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="4" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - D" Margin="5"/>
                                        </Border>

                                        <Border Grid.Row="5" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - A" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - B" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="5" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - C" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="5" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - D" Margin="5"/>
                                        </Border>

                                        <Border Grid.Row="6" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - A" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="6" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - B" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="6" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - C" Margin="5"/>
                                        </Border>
                                        <Border Grid.Row="6" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Text="Row 4 - D" Margin="5"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel
                        Width="auto"
                        Height="auto">
                                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            Kind="ClockOutline" />
                                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="Lịch sử" />
                                    </StackPanel>
                                </TabItem.Header>
                                <StackPanel
        Margin="16">
                                    <TextBlock
          Margin="0,0,0,8"
          Style="{StaticResource MaterialDesignHeadline5TextBlock}"
          Text="Recent" />
                                    <TextBlock>
          <Run
            Text="tab 2 content. Default look and behaviors." />
          <LineBreak />
          <LineBreak />
          <Run
            FontStyle="Italic">
          Praesent sed dui arcu. Vivamus porta auctor sagittis
        </Run>
                                    </TextBlock>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
