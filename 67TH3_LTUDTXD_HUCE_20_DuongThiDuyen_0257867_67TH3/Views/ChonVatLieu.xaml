<Window x:Class="_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.Views.ChonVatLieu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.Views" xmlns:vm="clr-namespace:_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.ViewModels"
        Title="Chọn Vật Liệu" Height="580" Width="800"
             ResizeMode="NoResize"
             WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:DangNhap/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="5" Height="580" 
                    Background="Gray" Width="450">
            <DataGrid x:Name="BangThongSo" AutoGenerateColumns="False" ItemsSource="{Binding dsm}"
          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,10,0,0"
          Height="200" Width="380"
          IsReadOnly="True" SelectionMode="Single"
          SelectedItem="{Binding ChonThongSo, Mode=TwoWay}" 
          MouseDoubleClick="MoTrangThongSo">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60"/>
                    <DataGridTextColumn Header="Mặt bằng" Binding="{Binding MatBang}" Width="100"/>
                    <DataGridTextColumn Header="Bê tông" Binding="{Binding BeTong}" Width="100"/>
                    <DataGridTextColumn Header="Cột thép dọc" Binding="{Binding CotThepDoc}"/>
                </DataGrid.Columns>
               
            </DataGrid>
        </Grid>
        

        <GroupBox Header="Hàm lượng cốt thép" HorizontalAlignment="Right" Width="320" Height="100"
                  VerticalAlignment="Top" Margin="0,0,15,0"
                  Grid.Row="0" Grid.Column="1" BorderThickness="2">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Hàm lượng tối thiểu:..........................." Width="150"/>
                    <TextBox Margin="0,-5,-220,2" Width="50" BorderThickness="2"/>
                </StackPanel>
            </StackPanel>
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Black" FontWeight="Bold" FontSize="14"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupBox.Style>
        </GroupBox>

        <GroupBox Header="Các thông số khác" HorizontalAlignment="Right" Width="320" Height="130"
                  VerticalAlignment="Top" Margin="0,0,15,0"
                  Grid.Column="1" Grid.Row="1" BorderThickness="2">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Lớp bê tông bảo vệ cốt thép (mm):" Width="220" Margin="0,6,0,0"/>
                    <TextBox Width="50"  BorderThickness="2" Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,15,0,15">
                    <TextBlock Text="Chiều cao làm việc của tiết diện ho (mm):" Width="220" Margin="0,6,0,0"/>
                    <TextBox Width="50"  BorderThickness="2" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Black" FontWeight="Bold" FontSize="14"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupBox.Style>
        </GroupBox>

        <GroupBox Header="Các thông số khác" HorizontalAlignment="Right" Width="320" Height="100"
                  VerticalAlignment="Top" Margin="0,0,15,0"
                  Grid.Column="1" Grid.Row="2" BorderThickness="2">
            <StackPanel Margin="10">
                <RadioButton Content="Theo TCVN 5574-2018" IsChecked="True"/>
                <RadioButton Content="Theo SP 63.13330.2012"/>
            </StackPanel>
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Black" FontWeight="Bold" FontSize="14"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupBox.Style>
        </GroupBox>

        <GroupBox Header="Hệ số" HorizontalAlignment="Right" Width="320" Height="100"
          VerticalAlignment="Top" Margin="0,0,15,0"
          Grid.Row="3" Grid.Column="1" BorderThickness="2">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Hệ số hạn chế vùng nén:..........................." Width="150"/>
                    <TextBox Margin="0,-5,-220,2" Width="50"  BorderThickness="2"/>
                </StackPanel>
            </StackPanel>
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Black" FontWeight="Bold" FontSize="14"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupBox.Style>
        </GroupBox>

        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,50,30">
            <Button Content="Đồng ý" Name="ConfirmButton" Width="100" Height="40" Margin="10" Background="#105FAD" BorderBrush="#105FAD" Command="{Binding ChuyenDenTrangKetQua}"/>
            <Button Content="Hủy bỏ" Name="CancelButton" Width="100" Height="40" Margin="10" Background="#105FAD" BorderBrush="#105FAD" Command="{Binding ChuyenDenTrangChu}"/>
        </StackPanel>

    </Grid>
</Window>
