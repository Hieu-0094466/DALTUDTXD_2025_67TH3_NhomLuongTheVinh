<Window x:Class="_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.Views.TrangKetQua"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.Views" xmlns:vm="clr-namespace:_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.ViewModels"
        mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1300"
        Title="TRANG CHỦ"
WindowStartupLocation="CenterScreen"
WindowState="Maximized">
    <Window.DataContext>
        <vm:DangNhap/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Ribbon Control -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Ribbon x:Name="RibbonWin" IsMinimized="True">

                <!-- Ribbon Tab #1: Home -->
                <RibbonTab Header="File" KeyTip="H" >
                    <!-- Home  group-->
                    <RibbonGroup x:Name="ClipboardGroup" Header="Home">
                        <RibbonMenuButton LargeImageSource="/Resources/Images/logo.png" Label="Paste" KeyTip="V">
                            <RibbonMenuItem ImageSource="/Resources/Images/logo.png" Header="Keep Text Only" KeyTip="T"/>
                            <RibbonMenuItem ImageSource="/Resources/Images/logo.png" Header="Paste Special..." KeyTip="S"/>
                        </RibbonMenuButton>
                        <RibbonButton SmallImageSource="/Resources/Images/logo.png" Label="Cut" KeyTip="X" />
                        <RibbonButton SmallImageSource="/Resources/Images/logo.png" Label="Copy" KeyTip="C" />
                        <RibbonButton SmallImageSource="/Resources/Images/logo.png" Label="Format Painter" KeyTip="FP" />
                    </RibbonGroup>
                </RibbonTab>
                <!-- Ribbon Tab #2: -->
                <RibbonTab Header="Tính toán" KeyTip="I">
                    <RibbonButton Margin="0,-80,0,0" LargeImageSource="/Resources/Images/calculate.png" 
                                  Label="Tính diện tích" KeyTip="V"
                                  Command="{Binding ChuyenDenTrangChonVL}">
                    </RibbonButton>
                </RibbonTab>
                <!-- Ribbon Tab #3: -->
                <RibbonTab Header="Hiển thị" KeyTip="L">
                </RibbonTab>
            </Ribbon>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar bên trái -->
            <StackPanel Grid.Column="0" Background="LightGray" Margin="10">
                <TextBlock Text="Mặt bằng" FontWeight="Bold"/>
                <ComboBox BorderThickness="2" Margin="0,10,0,50">
                    <ComboBoxItem Content="STORY1" IsSelected="True"/>
                </ComboBox>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Grid.Row="0" 
                        Width="100" Height="50" 
                        Background="White" 
                        Content="Thêm"
                        Foreground="Black"/>
                    <Button Grid.Column="1" Grid.Row="1" 
                        Width="100" Height="50" 
                        Background="White" 
                        Content="Xóa"
                        Foreground="Black"/>
                    <Button Grid.Column="1" Grid.Row="0" 
                        Width="100" Height="50" 
                        Background="White" 
                        Content="Sửa"
                        Foreground="Black"/>
                    <Button Grid.Column="0" Grid.Row="1" 
                        Width="100" Height="50" 
                        Background="White" 
                        Content="Xóa"
                        Foreground="Black"/>
                </Grid>
            </StackPanel>


            <Canvas Grid.Column="1">
                <Image HorizontalAlignment="Left" Source="/Resources/Images/ketqua.png"/>
            </Canvas>
        </Grid>
    </Grid>
</Window>
