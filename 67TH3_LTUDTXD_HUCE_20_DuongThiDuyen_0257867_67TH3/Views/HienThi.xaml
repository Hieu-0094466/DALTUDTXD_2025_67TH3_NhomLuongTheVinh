<Window x:Class="_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.Views.HienThi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.Views"
             xmlns:fluent1="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon" 
             xmlns:vm="clr-namespace:_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.ViewModels"
             Title="Hiển Thị" Height="500" Width="500"
             WindowStyle ="None"
             ResizeMode="NoResize"
             WindowStartupLocation="CenterScreen"
             MouseDown="Window_MouseDown"
             AllowsTransparency="True">
    
    <Window.DataContext>
        <vm:DangNhap />
    </Window.DataContext>

    <Border CornerRadius="10"       
    BorderThickness="1"
    Width="500"
    Height="500">

        <Border.Background>
            <ImageBrush ImageSource="/Resources/Images/back2.png" Opacity="0.3"/>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="5"/>

                </Grid.ColumnDefinitions>

                <TextBlock Text="LỰA CHỌN"
                   Foreground="DarkGray"
                   FontSize="10"
                   FontFamily="Montserrat"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>

                <Button x:Name="btnMinimize"                            
                BorderThickness="0"
                Content="-"
                Foreground="White"
                FontSize="16"
                FontFamily="Montserrat"
                Cursor="Hand"
                Grid.Column="1"
                Click="btnMinimize_Click">
                    <Button.Style>
                        <Style  TargetType="Button">
                            <Setter Property="Background" Value="#105FAD"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#278BEF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="18" Height="18"
                            CornerRadius="9"
                            Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnClose"                      
                 BorderThickness="0"
                 Content="X"
                 Foreground="White"
                 FontSize="12"                           
                 FontFamily="Montserrat"
                 Cursor="Hand"
                 Grid.Column="2"
                 Click="btnClose_Click">

                    <Button.Style>
                        <Style  TargetType="Button">
                            <Setter Property="Background" Value="IndianRed"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C62DAE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="18" Height="18"
                            CornerRadius="9"
                            Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
            <StackPanel Width="256"
                Grid.Row="2"
                Orientation="Vertical">

                <Button                      
             BorderThickness="0"
             Content="Đọc file MDB"
             Foreground="White"
             FontSize="12"                           
             FontFamily="Montserrat"
             Cursor="Hand"
             Grid.Column="2"
             Margin="0,80,0,0"
                    Command="{Binding ChuyenDenTaoFileMoi}">

                    <Button.Style>
                        <Style  TargetType="Button">
                            <Setter Property="Background" Value="#105fad"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#28AEED"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="200" Height="50"
CornerRadius="10"
Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
              HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button                      
             BorderThickness="0"
             Content="Mở File Cũ"
             Foreground="White"
             FontSize="12"                           
             FontFamily="Montserrat"
             Cursor="Hand"
             Grid.Column="2"
                    Margin="0,50,0,50">

                    <Button.Style>
                        <Style  TargetType="Button">
                            <Setter Property="Background" Value="#105fad"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#28AEED"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="200" Height="50"
CornerRadius="10"
Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
              HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                
                <Button                      
             BorderThickness="0"
             Content="Trang Chủ"
             Foreground="White"
             FontSize="12"                           
             FontFamily="Montserrat"
             Cursor="Hand"
             Grid.Column="2"
             Command="{Binding ChuyenDenTrangChu}">

                    <Button.Style>
                        <Style  TargetType="Button">
                            <Setter Property="Background" Value="#105fad"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#28AEED"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="200" Height="50"
CornerRadius="10"
Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
              HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

        </Grid>

    </Border>
</Window>
