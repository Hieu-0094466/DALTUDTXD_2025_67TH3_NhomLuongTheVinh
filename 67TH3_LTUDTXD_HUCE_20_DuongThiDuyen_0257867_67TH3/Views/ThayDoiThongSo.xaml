<Window x:Class="_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.Views.ThayDoiThongSo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.Views" xmlns:vm="clr-namespace:_67TH3_LTUDTXD_HUCE_20_DuongThiDuyen_0257867_67TH3.ViewModels"
        Title="Chỉnh sửa" Height="200" Width="300"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:DangNhap/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ComboBox chọn Bê Tông -->
        <TextBlock Text="Bê Tông" Grid.Row="0" Margin="10"/>
        <ComboBox x:Name="cbBeTong" Grid.Row="0" Margin="100,10,10,20"
                  ItemsSource="{Binding DanhSachBeTong}"
                  SelectedItem="{Binding BeTong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- ComboBox chọn Cốt Thép Dọc -->
        <TextBlock Text="Cốt Thép Dọc" Grid.Row="1" Margin="10"/>
        <ComboBox x:Name="cbCotThep" Grid.Row="1" Margin="100,10,10,30"
                  ItemsSource="{Binding DanhSachCotThepDoc}" SelectedItem="{Binding CotThepDoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Nút Lưu -->
        <Button Width="150" Content="Lưu" Grid.Row="2" Margin="10" 
                Command="{Binding ChinhSuaThongSo}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
</Window>
